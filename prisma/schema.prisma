generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TweetStatus {
  NEW
  DRAFTED
  APPROVED
  REJECTED
  REPLIED
}

enum Relationship {
  STRANGER
  FOLLOWING
  FOLLOWER
  MUTUAL
  SELF
}

model Tweet {
  id            String      @id @default(cuid())
  tweetId       String      @unique
  authorId      String
  authorHandle  String
  text          String      @db.Text

  conversationId String?
  createdAtX     DateTime?

  status        TweetStatus @default(NEW)

  draft         Draft?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Draft {
  id          String   @id @default(cuid())

  tweet       Tweet    @relation(fields: [tweetId], references: [id], onDelete: Cascade)
  tweetId     String   @unique

  reply       String   @db.Text

  confidence  Int
  reason      String

  approved    Boolean  @default(false)
  posted      Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ReplyMemory {
  id          String   @id @default(cuid())

  tweetId     String   @unique
  tweetText   String   @db.Text
  authorHandle String
  relationship Relationship

  aiDraft     String   @db.Text
  editedReply String?  @db.Text
  finalReply  String   @db.Text

  wasEdited   Boolean  @default(false)
  approved    Boolean  @default(false)

  createdAt   DateTime @default(now())

  @@index([createdAt])
}